# swarm's own state: sockets, logs, staged files, the CLI shim
.swarm/

# a swarm.yaml here is somebody's fleet, not part of the project.
# swarm.example.yaml is the one that ships; `swarm init` writes the other.
/swarm.yaml
/swarm.yml
/.swarm.yaml
/.swarm.yml

# terminal recordings made while testing
*.cast

# scratch: notes and drafts that are not the project
/IDEAS/


# built binaries, wherever they land: a Windows VM sharing this directory
# drops its copy here, and `git add -A` will take it if the pattern is narrow
*.exe
/swarm
